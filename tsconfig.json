{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "apps/api/src/**/*.ts",
    "apps/api/src/**/*.d.ts",
    "packages/**/*.ts",
    "packages/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/web"
  ]
}

{
  "name": "qc-maestro",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "npm run dev --workspace @qc/web",
    "dev:demo": "node apps/demo-app/server.js",
    "dev:qc-fixture": "node apps/unique-demo/server.js",
    "check": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "start": "tsx apps/api/src/server.ts",
    "test": "npm run check",
    "test:e2e": "tsx apps/api/src/tests/e2e.ts",
    "qc:e2e": "node scripts/run-autonomous-e2e.mjs",
    "qc:gate": "node scripts/qc-regression-gate.cjs",
    "qc:ci": "node scripts/qc-ci-adapter.cjs",
    "qc:retain": "node scripts/qc-retain-artifacts.cjs",
    "setup": "npm install && npm run playwright:install && npm run build",
    "build": "npm run build --workspace @qc/web",
    "validate:example": "tsx packages/flow-schema/src/cli.ts docs/examples/login.yaml",
    "playwright:install": "playwright install chromium",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "infra:up": "docker compose -f infrastructure/compose/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/compose/docker-compose.yml down",
    "seed:jamaahku": "node scripts/seed-jamaahku.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
